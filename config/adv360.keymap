#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        lbrace: lbrace {
            compatible = "zmk,behavior-mod-morph";
            label = "LBRACE";
            bindings = <&kp LEFT_BRACE>, <&kp LEFT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rbrace: rbrace {
            compatible = "zmk,behavior-mod-morph";
            label = "RBRACE";
            bindings = <&kp RIGHT_BRACE>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        symb {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp EXCL   &kp AT           &kp POUND  &kp DLLR   &kp PRCNT  &tog 2                                                  &mo 4      &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp MINUS
&kp TAB    &kp Q      &kp W            &kp F      &kp P      &kp G      &tog 1                                                  &none      &kp J      &kp L     &kp U      &kp Y     &kp SEMI  &kp BSLH
&kp ESC    &kp A      &kp R            &kp S      &kp T      &kp D      &none     &kp LCTRL  &kp LCMD      &kp RGUI  &kp RCTRL  &none      &kp H      &kp N     &kp E      &kp I     &kp O     &kp APOS
&kp LSHFT  &kp Z      &kp X            &kp C      &kp V      &kp B                           &kp CAPS      &kp LALT                        &kp K      &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 3      &kp GRAVE  &kp PRINTSCREEN  &kp LEFT   &kp RIGHT             &kp BSPC  &kp DEL    &kp UP        &kp DOWN  &kp ENTER  &kp SPACE             &kp RALT  &lbrace    &rbrace   &kp END   &mo 3
            >;
        };

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2           &kp N3    &kp N4     &kp N5  &tog 2                                                  &mo 4      &kp N6  &kp N7    &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W            &kp F     &kp P      &kp G   &trans                                                  &none      &kp J   &kp L     &kp U      &kp Y    &kp SEMI  &kp BSLH
&kp ESC    &kp A      &kp R            &kp S     &kp T      &kp D   &tog 0    &kp LCTRL  &kp LCMD      &kp RGUI  &kp RCTRL  &none      &kp H   &kp N     &kp E      &kp I    &kp O     &kp APOS
&kp LSHFT  &kp Z      &kp X            &kp C     &kp V      &kp B                        &kp CAPS      &kp LALT                        &kp K   &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
&mo 3      &kp GRAVE  &kp PRINTSCREEN  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp UP        &kp DOWN  &kp ENTER  &kp SPACE          &kp RALT  &lbrace    &rbrace  &kp END   &mo 3
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                            &mo 4      &kp N6  &kp KP_NUM      &kp KP_EQUAL    &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                             &none      &kp Y   &msc SCRL_UP    &mmv MOVE_UP    &msc SCRL_DOWN   &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LGUI          &kp RGUI        &mkp RCLK  &none      &kp H   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp CAPS          &kp LALT                              &kp N   &msc SCRL_LEFT  &kp KP_N2       &msc SCRL_RIGHT  &kp KP_ENTER     &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp UP_ARROW      &kp DOWN_ARROW  &kp ENTER  &mkp LCLK          &kp UP          &kp DOWN        &kp KP_DOT       &kp RBKT         &mo 3
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2     &kp F3    &kp F4     &kp F5    &kp F6  &tog 2                                              &mo 4   &kp F7        &kp F8    &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans     &kp EXCL  &kp LPAR   &kp RPAR  &trans  &none                                               &none   &trans        &kp N7    &kp N8  &kp N9   &trans   &trans
&trans  &kp MINUS  &kp PLUS  &kp EQUAL  &kp GT    &trans  &none   &trans  &trans         &trans    &kp DOT    &none   &kp C_VOL_UP  &kp N4    &kp N5  &kp N6   &trans   &trans
&trans  &trans     &trans    &trans     &trans    &trans                  &kp PG_UP      &trans                       &kp C_VOL_DN  &kp N1    &kp N2  &kp N3   &trans   &trans
&trans  &trans     &trans    &trans     &trans            &trans  &trans  &kp PG_DN      &kp BSLH  &kp UNDER  &trans                &kp HOME  &kp N0  &kp END  &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };
    };
};
